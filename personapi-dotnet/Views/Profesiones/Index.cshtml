@* Lista de profesiones en una tabla, con botones para ver, editar y eliminar cada registro. *@
@model IEnumerable<Profesion>
@{
    ViewData["Title"] = "Profesiones";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Profesiones</h1>
    <a class="btn btn-primary" asp-action="Create">Nueva profesión</a>
</div>
<div class="table-responsive">
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Id)</th>
            <th>@Html.DisplayNameFor(m => m.Nom)</th>
            <th>@Html.DisplayNameFor(m => m.Des)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.Nom</td>
            <td class="text-muted">@item.Des</td>
            <td class="acciones text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Ver</a>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
            </td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr><td colspan="4" class="text-center text-muted">No hay profesiones registradas.</td></tr>
    }
    </tbody>
</table>
</div>
