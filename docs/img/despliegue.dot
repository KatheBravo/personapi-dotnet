digraph Despliegue {
  graph [rankdir=LR, bgcolor=white, pad=0.3, nodesep=0.5, ranksep=0.7];
  node [shape=box3d, fontname="DejaVu Sans", fontsize=10, style=filled, fillcolor="#ECEFF1", color="#455A64"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#37474F"];
  user [label="Usuario\nnavegador / Swagger", shape=box, style="rounded,filled", fillcolor="#FFF8E1"];
  subgraph cluster_host { label="Host con Docker (docker compose)"; style=rounded; color="#1565C0"; fontname="DejaVu Sans"; fontcolor="#1565C0";
    subgraph cluster_net { label="red interna personapi-dotnet_default"; style="rounded,dashed"; color="#90A4AE"; fontname="DejaVu Sans"; fontcolor="#455A64";
      app [label="personapi-app\nimagen personapi-dotnet:1.0.0\n(aspnet:7.0) · puerto 8080"];
      init [label="personapi-db-init\nsqlcmd -i DDL.sql, DML.sql\n(se ejecuta una vez)"];
      sql [label="personapi-sqlserver\nmssql/server:2022-latest\nExpress · puerto 1433"];
    }
    vol [label="volumen\nsqlserver-data", shape=cylinder, fillcolor="#FFEBEE"];
  }
  user -> app [label="HTTP :8080"];
  app -> sql [label="TDS :1433"];
  init -> sql [label="TDS :1433", style=dashed];
  sql -> vol [label="/var/opt/mssql"];
}
