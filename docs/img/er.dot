digraph ER {
  graph [rankdir=LR, bgcolor=white, pad=0.3, nodesep=0.6, ranksep=0.9, fontname="DejaVu Sans"];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=10, color="#37474F", arrowsize=0.8];
  profesion [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5">
    <tr><td bgcolor="#1565C0"><font color="white"><b>profesion</b></font></td></tr>
    <tr><td align="left" port="id">PK  id : INT</td></tr>
    <tr><td align="left">nom : VARCHAR(90)</td></tr>
    <tr><td align="left">des : VARCHAR(MAX)</td></tr></table>>];
  estudios [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5">
    <tr><td bgcolor="#1565C0"><font color="white"><b>estudios</b></font></td></tr>
    <tr><td align="left" port="idp">PK,FK  id_prof : INT</td></tr>
    <tr><td align="left" port="cc">PK,FK  cc_per : INT</td></tr>
    <tr><td align="left">fecha : DATE</td></tr>
    <tr><td align="left">univer : VARCHAR(50)</td></tr></table>>];
  persona [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5">
    <tr><td bgcolor="#1565C0"><font color="white"><b>persona</b></font></td></tr>
    <tr><td align="left" port="cc">PK  cc : INT</td></tr>
    <tr><td align="left">nombre : VARCHAR(45)</td></tr>
    <tr><td align="left">apellido : VARCHAR(45)</td></tr>
    <tr><td align="left">genero : CHAR(1)  M | F</td></tr>
    <tr><td align="left">edad : INT</td></tr></table>>];
  telefono [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="5">
    <tr><td bgcolor="#1565C0"><font color="white"><b>telefono</b></font></td></tr>
    <tr><td align="left">PK  num : VARCHAR(15)</td></tr>
    <tr><td align="left">oper : VARCHAR(45)</td></tr>
    <tr><td align="left" port="d">FK  duenio : INT</td></tr></table>>];
  profesion:id -> estudios:idp [arrowhead=crow, arrowtail=tee, dir=both, label="1 : N"];
  persona:cc -> estudios:cc [arrowhead=crow, arrowtail=tee, dir=both, label="1 : N"];
  persona:cc -> telefono:d [arrowhead=crow, arrowtail=tee, dir=both, style=dashed, label="1 : N"];
  {rank=same; profesion}
}
