@model IEnumerable<Telefono>
@{
    ViewData["Title"] = "Teléfonos";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Teléfonos</h1>
    <a class="btn btn-primary" asp-action="Create">Nuevo teléfono</a>
</div>
<div class="table-responsive">
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Num)</th>
            <th>@Html.DisplayNameFor(m => m.Oper)</th>
            <th>@Html.DisplayNameFor(m => m.Duenio)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Num</td>
            <td>@item.Oper</td>
            <td>@item.Duenio - @item.DuenioNavigation.Nombre @item.DuenioNavigation.Apellido</td>
            <td class="acciones text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Num">Ver</a>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Num">Editar</a>
                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Num">Eliminar</a>
            </td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr><td colspan="4" class="text-center text-muted">No hay teléfonos registrados.</td></tr>
    }
    </tbody>
</table>
</div>
