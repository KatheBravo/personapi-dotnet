@* Plantilla común de todas las páginas: menú superior, aviso de éxito y pie.
   Cada vista se "inyecta" donde está @RenderBody(). *@
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - personapi-dotnet</title>
    @* Bootstrap 5 desde CDN para el diseño (tablas, botones, formularios). *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-primary mb-4">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">personapi-dotnet</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"
                        aria-controls="menu" aria-expanded="false" aria-label="Menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menu">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Personas" asp-action="Index">Personas</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Profesiones" asp-action="Index">Profesiones</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Estudios" asp-action="Index">Estudios</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Telefonos" asp-action="Index">Teléfonos</a></li>
                    </ul>
                    <a class="btn btn-light btn-sm" href="~/swagger">API (Swagger)</a>
                </div>
            </div>
        </nav>
    </header>

    <main class="container pb-5">
        @* Mensaje verde que dejan los controladores en TempData después de guardar o borrar. *@
        @if (TempData["Mensaje"] is string mensaje)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @mensaje
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @* Aquí se dibuja el contenido de la vista que se esté mostrando. *@
        @RenderBody()
    </main>

    <footer class="border-top py-3 text-muted small">
        <div class="container">Laboratorio 1 · Monolito MVC + DAO · .NET 10 · SQL Server 2025</div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
