@model Persona
@{
    ViewData["Title"] = "Editar persona";
    ViewData["EsEdicion"] = true;
}
<h1 class="h3">Editar persona</h1>
<form asp-action="Edit" asp-route-id="@Model.Cc" method="post" class="col-lg-8">
    <partial name="_Formulario" model="Model" />
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a class="btn btn-link" asp-action="Index">Volver</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
