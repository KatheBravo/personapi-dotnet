@model IEnumerable<Estudio>
@{
    ViewData["Title"] = "Estudios";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Estudios</h1>
    <a class="btn btn-primary" asp-action="Create">Nuevo estudio</a>
</div>
<div class="table-responsive">
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Persona</th>
            <th>Profesión</th>
            <th>@Html.DisplayNameFor(m => m.Univer)</th>
            <th>@Html.DisplayNameFor(m => m.Fecha)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.CcPer - @item.CcPerNavigation.Nombre @item.CcPerNavigation.Apellido</td>
            <td>@item.IdProf - @item.IdProfNavigation.Nom</td>
            <td>@item.Univer</td>
            <td>@item.Fecha?.ToString("yyyy-MM-dd")</td>
            <td class="acciones text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-idProf="@item.IdProf" asp-route-ccPer="@item.CcPer">Ver</a>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-idProf="@item.IdProf" asp-route-ccPer="@item.CcPer">Editar</a>
                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-idProf="@item.IdProf" asp-route-ccPer="@item.CcPer">Eliminar</a>
            </td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr><td colspan="5" class="text-center text-muted">No hay estudios registrados.</td></tr>
    }
    </tbody>
</table>
</div>
