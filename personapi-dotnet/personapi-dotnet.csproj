<!-- Archivo del proyecto: dice qué versión de .NET se usa y qué paquetes NuGet necesita. -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- .NET 10: la versión LTS vigente (soporte hasta noviembre de 2028). -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>personapi_dotnet</RootNamespace>
    <AssemblyName>personapi-dotnet</AssemblyName>
    <!-- Convierte los comentarios /// en un XML que Swagger usa para describir cada endpoint. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 1591 = "falta comentario XML". Lo silenciamos para no exigir /// en cada miembro. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Entity Framework Core: el ORM, más su proveedor para SQL Server y las herramientas
         que traen el comando Scaffold-DbContext. Su versión siempre va de la mano con la de .NET. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Swashbuckle genera la especificación OpenAPI 3 y la página de Swagger UI.
         La versión 10 es la que da soporte a .NET 8 en adelante. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <!-- Dependencia indirecta (la trae el cliente de SQL Server). Se fija en la versión con los
         últimos parches de seguridad para que NuGet no use una versión con vulnerabilidades conocidas. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
