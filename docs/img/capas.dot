digraph Capas {
  graph [rankdir=TB, bgcolor=white, pad=0.3, nodesep=0.5, ranksep=0.55, fontname="DejaVu Sans", newrank=true];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=11, color="#455A64", fillcolor="#ECEFF1"];
  edge [color="#37474F", arrowsize=0.8, fontname="DejaVu Sans", fontsize=9];
  nav [label="Navegador", fillcolor="#FFF8E1"];
  cli [label="Cliente REST\n(Swagger UI, curl, Postman)", fillcolor="#FFF8E1"];
  subgraph cluster_app { label="Monolito personapi-dotnet (ASP.NET Core 7)"; style="rounded"; color="#1565C0"; fontcolor="#1565C0";
    subgraph cluster_v { label="Vista"; style="rounded,dashed"; color="#90A4AE"; fontcolor="#455A64";
      views [label="Vistas Razor (.cshtml)\nIndex · Create · Edit · Details · Delete"]; }
    subgraph cluster_c { label="Controlador"; style="rounded,dashed"; color="#90A4AE"; fontcolor="#455A64";
      mvc [label="Controladores MVC\nPersonas · Profesiones\nEstudios · Telefonos"];
      api [label="Controladores API\n/api/personas · /api/profesiones\n/api/estudios · /api/telefonos"];
      dto [label="DTO", fillcolor="#E3F2FD"]; }
    subgraph cluster_m { label="Modelo"; style="rounded,dashed"; color="#90A4AE"; fontcolor="#455A64";
      iface [label="Interfaces DAO\nIPersonaRepository …", fillcolor="#E8F5E9"];
      repo [label="Repositorios DAO\nPersonaRepository …", fillcolor="#E8F5E9"];
      ctx [label="PersonaDbContext + Entidades\n(Entity Framework Core 7)"]; }
  }
  db [label="SQL Server 2022\npersona_db", shape=cylinder, fillcolor="#FFEBEE"];
  nav -> mvc [label="HTTP (HTML)"];
  cli -> api [label="HTTP (JSON)"];
  mvc -> views;
  api -> dto;
  mvc -> iface; api -> iface;
  iface -> repo [label="implementa", dir=back, style=dashed];
  repo -> ctx;
  ctx -> db [label="ADO.NET / TDS"];
}
