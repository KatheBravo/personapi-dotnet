@model Telefono
@{
    ViewData["Title"] = "Detalle de teléfono";
}
<h1 class="h3">Teléfono @Model.Num</h1>
<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Oper)</dt><dd class="col-sm-9">@Model.Oper</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Duenio)</dt>
    <dd class="col-sm-9"><a asp-controller="Personas" asp-action="Details" asp-route-id="@Model.Duenio">@Model.Duenio - @Model.DuenioNavigation.Nombre @Model.DuenioNavigation.Apellido</a></dd>
</dl>
<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Num">Editar</a>
<a class="btn btn-link" asp-action="Index">Volver</a>
