@model Persona
@{
    var esEdicion = (bool)(ViewData["EsEdicion"] ?? false);
}
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="mb-3">
    <label asp-for="Cc" class="form-label"></label>
    @if (esEdicion)
    {
        <input asp-for="Cc" class="form-control" readonly />
    }
    else
    {
        <input asp-for="Cc" class="form-control" />
    }
    <span asp-validation-for="Cc"></span>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" maxlength="45" />
        <span asp-validation-for="Nombre"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Apellido" class="form-label"></label>
        <input asp-for="Apellido" class="form-control" maxlength="45" />
        <span asp-validation-for="Apellido"></span>
    </div>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Genero" class="form-label"></label>
        <select asp-for="Genero" class="form-select" asp-items="ViewBag.Generos">
            <option value="">-- Seleccione --</option>
        </select>
        <span asp-validation-for="Genero"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Edad" class="form-label"></label>
        <input asp-for="Edad" class="form-control" min="0" max="150" />
        <span asp-validation-for="Edad"></span>
    </div>
</div>
