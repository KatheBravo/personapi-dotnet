@* Formulario para registrar un teléfono nuevo y elegir a su dueño. *@
@model Telefono
@{
    ViewData["Title"] = "Nuevo teléfono";
}
<h1 class="h3">Nuevo teléfono</h1>
<form asp-action="Create" method="post" class="col-lg-8">
    <partial name="_Formulario" model="Model" />
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a class="btn btn-link" asp-action="Index">Volver</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
