digraph Clases {
  graph [rankdir=TB, bgcolor=white, pad=0.3, nodesep=0.35, ranksep=0.7];
  node [shape=plain, fontname="DejaVu Sans", fontsize=10];
  edge [color="#37474F", arrowsize=0.9];
  ctrl [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#ECEFF1"><b>PersonasController</b> / <b>PersonaApiController</b></td></tr>
    <tr><td align="left">- _personas : IPersonaRepository</td></tr>
    <tr><td align="left">+ Index() · Create() · Edit() · Delete()<br align="left"/>+ GetAll() · GetById() · Create() · Update() · Delete()<br align="left"/></td></tr></table>>];
  iface [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#E8F5E9"><i>«interface»</i><br/><b>IPersonaRepository</b></td></tr>
    <tr><td align="left">+ GetAllAsync() : Task&lt;IEnumerable&lt;Persona&gt;&gt;<br align="left"/>+ GetByIdAsync(cc) : Task&lt;Persona?&gt;<br align="left"/>+ ExistsAsync(cc) : Task&lt;bool&gt;<br align="left"/>+ CreateAsync(persona) : Task&lt;Persona&gt;<br align="left"/>+ UpdateAsync(persona) : Task&lt;bool&gt;<br align="left"/>+ DeleteAsync(cc) : Task&lt;bool&gt;<br align="left"/></td></tr></table>>];
  repo [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#E8F5E9"><b>PersonaRepository</b></td></tr>
    <tr><td align="left">- _context : PersonaDbContext</td></tr>
    <tr><td align="left">(implementa las 6 operaciones con EF Core)</td></tr></table>>];
  ctx [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#ECEFF1"><b>PersonaDbContext</b></td></tr>
    <tr><td align="left">+ Personas · Profesions · Estudios · Telefonos : DbSet</td></tr></table>>];
  ent [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4">
    <tr><td bgcolor="#E3F2FD"><b>Persona</b></td></tr>
    <tr><td align="left">+ Cc : int<br align="left"/>+ Nombre · Apellido · Genero : string<br align="left"/>+ Edad : int?<br align="left"/>+ Estudios · Telefonos : ICollection<br align="left"/></td></tr></table>>];
  ctrl -> iface [label="  usa", fontname="DejaVu Sans", fontsize=9, arrowhead=vee];
  repo -> iface [style=dashed, arrowhead=onormal, label="  implementa", fontname="DejaVu Sans", fontsize=9];
  repo -> ctx [arrowhead=vee];
  ctx -> ent [arrowhead=diamond, dir=back, arrowtail=odiamond];
  {rank=same; iface}
}
