@* Formulario de edición. La llave primaria se muestra pero no se puede cambiar. *@
@model Profesion
@{
    ViewData["Title"] = "Editar profesión";
    ViewData["EsEdicion"] = true;
}
<h1 class="h3">Editar profesión</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="col-lg-8">
    <partial name="_Formulario" model="Model" />
    <button type="submit" class="btn btn-primary">Guardar cambios</button>
    <a class="btn btn-link" asp-action="Index">Volver</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
